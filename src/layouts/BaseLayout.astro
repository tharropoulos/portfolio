---
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import inter from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import archivoFaces from "@fontsource-variable/archivo/wdth.css?inline";
import interFaces from "@fontsource-variable/inter/opsz.css?inline";
import dmMono400Faces from "@fontsource/dm-mono/400.css?inline";
import dmMono500Faces from "@fontsource/dm-mono/500.css?inline";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/main-nav";
import ScrollProgressBar from "@/components/scrollbar";
import "@/index.css";

interface Props {
  title?: string;
  description?: string;
  currentPath: string;
}

const {
  title = "Fanis Tharropoulos | Software Engineer",
  description = "Software engineer based in Athens, Greece. Projects, experience, and things I'm excited about.",
  currentPath,
} = Astro.props;

const links = [
  { id: "about", href: "/", label: "About" },
  { id: "work", href: "/experience", label: "Work" },
  { id: "writing", href: "/blog", label: "Writing" },
];
const showScrollProgressBar =
  currentPath === "/" || (currentPath.startsWith("/blog/") && currentPath !== "/blog");

// Raw's faces sit in one style the router keeps across navigations. Swapped in with each
// page they'd be registered anew, and the page would set in the fallback for a frame:
// long enough for a view transition to capture it and reflow when it ends.
const rawFonts = [archivoFaces, interFaces, dmMono400Faces, dmMono500Faces].join("\n");
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <Analytics />
    <title>{title}</title>
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={rawFonts} data-astro-transition-persist="raw-fonts" />
  </head>
  <body>
    <div class="flex min-h-screen w-full flex-col items-center bg-background">
      <div transition:persist class="fixed inset-x-0 top-0 z-50">
        <Navbar client:load currentPath={currentPath} links={links} />
      </div>
      {showScrollProgressBar && (
        <div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-16">
          <ScrollProgressBar
            client:load
            color="oklch(0.777 0.152 181.912)"
            strokeSize={2}
          />
        </div>
      )}
      <slot />
    </div>
  </body>
</html>
