---
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import inter from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import archivoFaces from "@fontsource-variable/archivo/wdth.css?inline";
import interFaces from "@fontsource-variable/inter/opsz.css?inline";
import dmMono400Faces from "@fontsource/dm-mono/400.css?inline";
import dmMono500Faces from "@fontsource/dm-mono/500.css?inline";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import { profile } from "@/data/profile";
import "@/index.css";

interface Props {
  title?: string;
  description?: string;
  // A post's date, which makes its link preview an article.
  published?: Date;
}

const {
  title = "Fanis Tharropoulos | Software Engineer",
  description = "Software engineer based in Athens, Greece. Projects, experience, and things I'm excited about.",
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// The front page's masthead, its links spelled out, over the teal footer with the domain.
const ogImage = new URL("/og.png", Astro.site);
const ogImageAlt = `The name fanis in large type, based in Athens, Greece, with ${profile.email}, ${profile.socials
  .map((social) => social.href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, ""))
  .join(", ")} and ${canonical.host}`;

// Raw's faces sit in one style the router keeps across navigations. Swapped in with each
// page they'd be registered anew, and the page would set in the fallback for a frame:
// long enough for a view transition to capture it and reflow when it ends.
const rawFonts = [archivoFaces, interFaces, dmMono400Faces, dmMono500Faces].join("\n");
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Paper, the page's background (--paper in index.css), so Chrome's bar matches it. */}
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Writing | Fanis Tharropoulos"
      href="/blog/rss.xml"
    />
    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:site_name" content="Fanis Tharropoulos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={rawFonts} data-astro-transition-persist="raw-fonts" />
    {/* The router takes scrolling over from the browser, and a reload inherits that: the
        page paints at the top until the router's script loads and scrolls it back down.
        Handing scrolling back on the way out lets the browser restore the reload before
        its first paint, and taking it again on show leaves back and forward to the router. */}
    <script is:inline>
      addEventListener("pagehide", () => (history.scrollRestoration = "auto"));
      addEventListener("pageshow", () => (history.scrollRestoration = "manual"));
    </script>
    {/* A figure's media that's still on its way waits hidden over its bone, then settles in
        when it arrives (see index.css). Media already in hand shows at once, and so does
        media that takes under a tenth of a second, like a reload's from the cache, since
        nobody saw it waiting. The parser's figures are caught as they're inserted, before
        the first paint, and the router's right after each swap, before the push captures
        them. Without scripts, nothing is hidden. */}
    <script is:inline>
      (() => {
        const media = "figure img, figure video";
        const still = matchMedia("(prefers-reduced-motion: reduce)");

        function hold(el) {
          if (el.dataset.media) return;
          // A video shows its poster until it plays, so it waits on that.
          let probe = el;
          if (el instanceof HTMLVideoElement) {
            if (!el.poster || el.readyState >= 2) return;
            probe = new Image();
            probe.src = el.poster;
          }
          if (probe.complete) return;

          el.dataset.media = "loading";
          const held = performance.now();
          const arrive = () => {
            if (el.dataset.media !== "loading") return;
            if (performance.now() - held < 100 || still.matches) {
              delete el.dataset.media;
              return;
            }
            el.dataset.media = "arriving";
            el.addEventListener("animationend", () => delete el.dataset.media, { once: true });
          };
          probe.addEventListener("load", arrive, { once: true });
          probe.addEventListener("error", arrive, { once: true });
          if (probe !== el) el.addEventListener("loadeddata", arrive, { once: true });
        }

        const parsing = new MutationObserver((records) => {
          for (const { addedNodes } of records) {
            for (const node of addedNodes) {
              if (!(node instanceof Element)) continue;
              if (node.matches(media)) hold(node);
              node.querySelectorAll(media).forEach(hold);
            }
          }
        });
        parsing.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener("DOMContentLoaded", () => parsing.disconnect(), { once: true });
        document.addEventListener("astro:after-swap", () => {
          document.querySelectorAll(media).forEach(hold);
        });
      })();
    </script>
  </head>
  <body class="bg-paper">
    <slot />
    {/* Not in the head: its custom element would end the head there, and push the title,
        the font preloads and the styles after it into the body, to be swapped out on every
        navigation. */}
    <Analytics />
  </body>
</html>
