---
// One role or degree, in the order people skim a CV: what and where, when and for how
// long, then the work and the stack. The first sentence is set in full ink, so reading
// only those still tells the story.
import type { Experience } from "@/data/experiences";

import { RoleAt } from "@/components/raw/role-at";
import { tenure } from "@/lib/utils";

interface Props {
  item: Experience;
  id?: string;
  // A degree's length isn't worth a line.
  showLength?: boolean;
}

const { item, id, showLength = true } = Astro.props;
const { span, length, kinds } = tenure(item.timeframe);
const [first, ...more] = item.description;
const [, lead = first, rest] = first.match(/^(.+?[.!?])\s+(.+)$/s) ?? [];
---

<article
  id={id}
  class="scroll-mt-4 border-t-hairline border-ink pb-[22px] pt-[18px] first:border-t-0"
>
  <h3 class="text-title font-[640] leading-[1.3] tracking-[-0.01em]">
    <RoleAt role={item.title} at={item.company} />
  </h3>
  <p class="mt-1 font-dm-mono text-meta tabular-nums text-ink-3">
    <span class="whitespace-nowrap">{span}</span>
    {showLength && length && <span class="whitespace-nowrap"> · {length}</span>}
    {kinds.length > 0 && <span class="lowercase"> · {kinds.join(", then ")}</span>}
  </p>
  <div class="mt-3 max-w-[66ch] space-y-[1em] text-ink-2">
    <p class="text-pretty text-ink">{lead}</p>
    {rest && <p>{rest}</p>}
    {more.map((d) => <p>{d}</p>)}
  </div>
  {
    item.skills && (
      <ul aria-label="Stack" class="mt-4 flex flex-wrap gap-1.5">
        {item.skills.map((skill) => (
          <li class="whitespace-nowrap border-hairline border-ink px-1.5 pb-0.5 pt-[3px] font-dm-mono text-label leading-[1.2] text-ink-2">
            {skill}
          </li>
        ))}
      </ul>
    )
  }
</article>
