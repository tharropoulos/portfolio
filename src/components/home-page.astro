---
import { Image } from "astro:assets";
import {
  ExternalLinkIcon,
  GitHubLogoIcon,
  LinkedInLogoIcon,
  TwitterLogoIcon,
} from "@radix-ui/react-icons";

import { AnimatedScanline } from "@/components/animated-scanline";
import { AnimatedUnderline } from "@/components/animated-underline";
import laravelNewsImage from "../assets/laravel-news.jpg";
import WorkExperienceList from "@/components/experience-list";
import Footer from "@/components/footer";
import { Heading } from "@/components/heading";
import { InterestsList } from "@/components/interests-list";
import SocialLinks from "@/components/socials";
import { profile } from "@/data/profile";
import { experiences, school } from "@/data/experiences";

const socialIcons = {
  github: GitHubLogoIcon,
  linkedin: LinkedInLogoIcon,
  x: TwitterLogoIcon,
} as const;

const socials = profile.socials.map((social) => ({
  href: social.href,
  icon: socialIcons[social.id],
}));
---

<>
  <main class="container mx-auto flex min-h-screen w-full max-w-screen-sm flex-col gap-6 bg-background">
    <div class="animate-fadein-slide opacity-0 transition-all [--fadein-delay:0ms]">
      <section id="home" class="mt-24 lg:mt-32">
        <div class="mb-10">
          <h1 class="mb-3 scroll-m-20 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
            {profile.name}
          </h1>
          <h3 class="scroll-m-20 text-lg font-semibold tracking-tight md:text-2xl">
            {profile.role}
          </h3>
        </div>
        <p class="leading-6 text-muted-foreground md:text-xl">
          {profile.intro}
        </p>
        <SocialLinks className="my-5 md:my-10" socials={socials} />
      </section>
      <div class="flex flex-col gap-14">
        <section id="about" class="flex flex-col">
          <Heading title="About" />
          <div class="flex w-full flex-col gap-2">
            <div class="mb-3 overflow-hidden sm:w-full lg:h-[30rem]">
              <Image
                src={laravelNewsImage}
                alt={profile.photo.alt}
                format="jpg"
                quality={100}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full animate-pan-zoom bg-cover object-cover"
              />
            </div>
            <p class="mb-0 text-sm font-medium md:text-base">
              <a
                href="https://www.youtube.com/live/YJmuKPk3d9M?si=iWKlDUubbKp8PQC2&t=19071"
                target="_blank"
                rel="noreferrer"
                aria-label="Open the LaraconEU talk timestamp on YouTube in a new tab"
                class="inline-flex items-center gap-1 text-muted-foreground transition-colors duration-200 hover:text-foreground hover:underline"
              >
                <span>{profile.photo.caption}</span>
                <ExternalLinkIcon className="h-4 w-4" />
              </a>
            </p>
            <p class="mt-0 text-xs text-muted-foreground md:text-sm">{profile.photo.date}</p>
          </div>
          <p class="text-sm leading-6 dark:text-zinc-200 md:text-base md:leading-7 [&:not(:first-child)]:mt-4 md:[&:not(:first-child)]:mt-6">
            {profile.about[0].before}<a
              href={profile.about[0].link.href}
              class="font-extrabold text-teal-600 underline hover:text-teal-900 dark:text-teal-300 dark:hover:text-teal-200"
            >{profile.about[0].link.label}</a>{profile.about[0].after}
          </p>
          <p class="text-sm leading-6 dark:text-zinc-200 md:text-base md:leading-7 [&:not(:first-child)]:mt-4 md:[&:not(:first-child)]:mt-6">
            {profile.about[1].before}
          </p>
          <p class="text-sm leading-6 dark:text-zinc-200 md:text-base md:leading-7 [&:not(:first-child)]:mt-4 md:[&:not(:first-child)]:mt-6">
            {profile.about[2].before}
          </p>
        </section>
        <section id="open-source" class="flex flex-col">
          <Heading title="Open Source" />
          <p class="text-sm leading-6 dark:text-zinc-200 md:text-base md:leading-7">
            I've coauthored a couple of apps under the{" "}
            <a
              href={profile.coauthoredOrg.href}
              class="font-extrabold text-teal-600 hover:underline dark:text-teal-300"
            >
              {profile.coauthoredOrg.label}
            </a>{" "}
            github org.
          </p>
          <ul class="ml-5 mt-3 list-disc space-y-2 text-sm leading-6 dark:text-zinc-200 md:text-base md:leading-7">
            {profile.coauthoredProjects.map((project, i) => {
              const delay = 0.1 + i * 1.8;
              return (
                <li>
                  <a
                    href={project.href}
                    class="font-extrabold text-teal-600 transition-all duration-200 hover:text-teal-900 dark:text-teal-300 dark:hover:text-teal-200"
                  >
                    {project.animation === "scanline" ? (
                      <AnimatedScanline client:visible animationDelay={delay}>
                        {project.name}
                      </AnimatedScanline>
                    ) : (
                      <AnimatedUnderline
                        client:visible
                        animationDelay={delay}
                        variant={project.animation}
                        className="stroke-teal-600 transition-all duration-200 hover:stroke-teal-900 dark:stroke-teal-300"
                      >
                        {project.name}
                      </AnimatedUnderline>
                    )}
                  </a>{" "}
                  {project.description}
                </li>
              );
            })}
          </ul>
        </section>
        <section id="work" class="flex flex-col">
          <Heading
            title="Work"
            link={{
              href: "/experience",
              label: "My full work experience",
            }}
          />
          <WorkExperienceList experiences={[...experiences.slice(0, 1)]} />
        </section>
        <section id="school" class="flex flex-col">
          <Heading title="School" />
          <WorkExperienceList experiences={school} />
        </section>
      </div>
    </div>
  </main>
  <Footer />
</>
