---
import { Image } from "astro:assets";

import { AnimatedScanline } from "@/components/animated-scanline";
import { AnimatedUnderline } from "@/components/animated-underline";
import LatestPullRequests from "@/components/latest-prs";
import { Education } from "@/components/raw/education";
import Frame from "@/components/raw/frame.astro";
import Masthead from "@/components/raw/masthead.astro";
import MonoLink from "@/components/raw/mono-link.astro";
import { RoleAt } from "@/components/raw/role-at";
import Section from "@/components/raw/section.astro";
import Sections from "@/components/raw/sections.astro";
import { Wordmark } from "@/components/raw/wordmark";
import laravelNewsImage from "@/assets/laravel-news.jpg";
import { experiences } from "@/data/experiences";
import { profile } from "@/data/profile";
import { formatBlogDate, getWriting } from "@/lib/blog";
import { years } from "@/lib/utils";

const talkHref = "https://www.youtube.com/live/YJmuKPk3d9M?si=iWKlDUubbKp8PQC2&t=19071";
const prsHref = `https://github.com/pulls?q=author%3A${profile.githubUsername}+is%3Apr`;
const [about1, about2, about3] = profile.about;
// The wordmark only says "fanis", so the lede carries the full name.
const lede = about1.before.replace(/^I'm /, `I'm ${profile.name}, `);
// Only the current job on the front page; the rest is one link away.
const job = experiences[0];

// "(κῦμα) is a TUI presentation tool…" → "κῦμα", "A TUI presentation tool…"
const tools = profile.coauthoredProjects.map((tool, i) => {
  const [, greek = "", what = tool.description] =
    tool.description.match(/^\((.+?)\)\s*(?:is )?(.*)$/) ?? [];
  return {
    ...tool,
    greek,
    what: what.charAt(0).toUpperCase() + what.slice(1),
    delay: 0.1 + i * 1.8,
  };
});
const scanlineColors = {
  line: "oklch(var(--teal) / 0.25)",
  shimmer: "oklch(0.85 0.08 185 / 0.75)",
  underline: "oklch(var(--teal))",
};

const posts = await getWriting();
---

<Frame currentPath="/">
  <Masthead>
    {/* The name runs past the bottom edge and gets clipped, so the cell carries its focus ring. */}
    <section
      aria-labelledby="name"
      class="push-hero overflow-hidden px-4 pt-6 [container-type:inline-size] has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-[-6px] has-[:focus-visible]:outline-ink"
    >
      <h1 id="name" class="sr-only">{profile.name}</h1>
      <Wordmark client:load />
      {/* Without JS the entrance never runs, so the name shows at rest. It can't be recast
          either, so the note would be wrong. */}
      <noscript>
        <style is:inline>
          .wordmark-letter,
          .wordmark-dot {
            opacity: 1 !important;
            transform: none !important;
          }
          .wordmark-note {
            display: none;
          }
        </style>
      </noscript>
    </section>
  </Masthead>

  <Sections
    sections={[
      { label: "About" },
      { label: "Work" },
      { label: "Open source" },
      { label: "Recent pull requests" },
      { label: "Writing" },
      { label: "Education" },
    ]}
  >
    <Section label="About">
      <div class="py-[18px] text-ink-2">
        <p
          class="mb-[0.75em] max-w-[40ch] text-pretty text-[clamp(22px,2.3vw,28px)] leading-[1.35] tracking-[-0.015em] text-ink"
        >
          {lede}<b class="font-[640]">{about1.link.label}</b>{about1.after}
        </p>
        {/* The interview, as the front page's photo. The title is the link and stretches over the
            whole figure; the play block says it's a video before anyone hovers. The bone
            shows while the photo's on its way (see BaseLayout). */}
        <figure
          class="group relative isolate my-7 max-w-[880px] overflow-hidden border-2 border-ink has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-[3px] has-[:focus-visible]:outline-ink"
        >
          <span
            class="relative block overflow-hidden bg-ink/[0.08] after:absolute after:inset-0 after:bg-ink/30 after:opacity-0 after:transition-opacity after:duration-150 after:ease-out group-hover:after:opacity-100 group-active:after:opacity-100"
          >
            {/* The source frame has a black bar down its left edge; crop it off. */}
            <Image
              src={laravelNewsImage}
              widths={[800, 1200, 1800]}
              sizes="(width < 900px) 100vw, min(880px, 72vw)"
              format="webp"
              alt={profile.photo.alt}
              class="-ml-[1.2%] block h-auto w-[101.2%] max-w-none"
            />
            <span
              aria-hidden="true"
              class="absolute bottom-0 left-0 z-[1] grid size-11 origin-bottom-left place-items-center bg-paper transition-[transform,background-color] duration-150 ease-out before:ml-0.5 before:h-[15px] before:w-[13px] before:bg-ink before:[clip-path:polygon(0_0,100%_50%,0_100%)] group-hover:bg-wash group-active:scale-[0.94] group-active:bg-wash min-[700px]:size-14 min-[700px]:before:ml-[3px] min-[700px]:before:h-[18px] min-[700px]:before:w-4"
            ></span>
          </span>
          <figcaption
            class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t-2 border-ink px-4 py-3 transition-colors duration-150 ease-out group-hover:bg-wash group-active:bg-wash"
          >
            <a
              href={talkHref}
              target="_blank"
              rel="noreferrer"
              class="text-body-lg font-semibold text-ink after:absolute after:inset-0 after:z-[1] focus-visible:outline-0"
            >
              {profile.photo.caption}
            </a>
            <span class="font-dm-mono text-label uppercase tracking-[0.06em] text-ink-3">
              Laravel News · {profile.photo.date}
            </span>
          </figcaption>
        </figure>
        <p class="max-w-[66ch]">{about2.before}</p>
        <p class="mt-[1em] max-w-[66ch]">{about3.before}</p>
      </div>
    </Section>

    <Section label="Work">
      <MonoLink slot="link" href="/work">Full work history</MonoLink>
      <article class="pb-[22px] pt-[18px]">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3.5">
          <h3 class="text-balance text-title font-[640] tracking-[-0.01em]">
            <RoleAt role={job.title} at={job.company} />
          </h3>
          <span class="font-dm-mono text-meta tabular-nums text-ink-3">{years(job.timeframe)}</span>
        </div>
        <div class="mt-3 max-w-[66ch] space-y-[1em] text-pretty text-ink-2">
          {job.description.map((d) => <p>{d}</p>)}
        </div>
      </article>
    </Section>

    <Section label="Open source">
      <MonoLink slot="link" href={profile.coauthoredOrg.site.href}>
        {profile.coauthoredOrg.site.label}
      </MonoLink>
      <p class="max-w-[66ch] text-pretty py-[18px] text-ink-2">
        I've coauthored a couple of apps under the{" "}
        {/* Label flush against the tags: a space inside the link gets underlined. */}
        <a
          href={profile.coauthoredOrg.href}
          class="text-ink underline decoration-[1.5px] underline-offset-[0.2em]"
        >{profile.coauthoredOrg.label}</a>{" "}
        GitHub org.
      </p>
      {/* The whole row clicks: the name's ::after stretches over it, and the row's ::before
          carries the hover fill out to the cell's edges like the other rows. */}
      <ul>
        {
          tools.map((tool) => (
            <li class="relative isolate grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-3.5 border-t-hairline border-ink py-4 before:absolute before:-inset-x-4 before:inset-y-0 before:z-[-1] before:transition-colors before:duration-150 before:ease-out first:border-t-0 hover:before:bg-wash active:before:bg-wash has-[:focus-visible]:before:outline has-[:focus-visible]:before:outline-2 has-[:focus-visible]:before:outline-offset-[-2px] has-[:focus-visible]:before:outline-ink min-[700px]:grid-cols-[7.5rem_5.5rem_minmax(0,1fr)] min-[700px]:gap-5">
              <a
                href={tool.href}
                class="font-cast text-tool font-[820] uppercase leading-none [font-stretch:62%] after:absolute after:inset-0 after:z-[1] focus-visible:outline-0"
              >
                {tool.animation === "scanline" ? (
                  <AnimatedScanline
                    client:visible
                    animationDelay={tool.delay}
                    colors={scanlineColors}
                  >
                    {tool.name}
                  </AnimatedScanline>
                ) : (
                  <AnimatedUnderline
                    client:visible
                    animationDelay={tool.delay}
                    variant={tool.animation}
                    className="stroke-teal"
                  >
                    {tool.name}
                  </AnimatedUnderline>
                )}
              </a>
              <span lang="el" class="font-dm-mono text-meta tabular-nums text-ink-3">
                {tool.greek}
              </span>
              <span class="col-span-full -mt-1 text-ink-2 min-[700px]:col-auto min-[700px]:mt-0">
                {tool.what}
              </span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section label="Recent pull requests">
      <MonoLink slot="link" href={prsHref} external>All on GitHub</MonoLink>
      <LatestPullRequests client:visible username={profile.githubUsername} />
    </Section>

    <Section label="Writing">
      <MonoLink slot="link" href="/blog">All posts</MonoLink>
      <ul>
        {
          posts.map((post) => (
            <li class="border-t-hairline border-ink first:border-t-0">
              {/* On phones the date drops under the title instead of squeezing it. */}
              <a
                href={post.href}
                class="-mx-4 grid grid-cols-[minmax(0,1fr)] items-baseline gap-0.5 px-4 py-3.5 transition-colors duration-150 ease-out hover:bg-wash active:bg-wash min-[700px]:grid-cols-[minmax(0,1fr)_auto] min-[700px]:gap-5"
              >
                <span class="text-pretty font-[520]">{post.title}</span>
                <span class="font-dm-mono text-meta tabular-nums text-ink-3">
                  <time datetime={post.date.toISOString()} class="whitespace-nowrap">
                    {formatBlogDate(post.date)}
                  </time>
                  {post.minutesRead && <> · {post.minutesRead}</>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section label="Education">
      <Education client:visible />
    </Section>
  </Sections>
</Frame>
