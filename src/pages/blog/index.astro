---
import Frame from "@/components/raw/frame.astro";
import Section from "@/components/raw/section.astro";
import Sections from "@/components/raw/sections.astro";
import Title from "@/components/raw/title.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatBlogDate, getWriting } from "@/lib/blog";

const posts = await getWriting();
---

<BaseLayout
  title="Writing | Fanis Tharropoulos"
  description="Notes on software engineering, open source, and developer tooling."
>
  <Frame currentPath="/blog">
    <Title>Writing</Title>

    <Sections sections={[{ label: "Posts" }]}>
      <Section label="Posts" fill>
        <p class="max-w-[66ch] text-pretty py-[18px] text-ink-2">
          Some longer-form writing for me to look back on in the future.
        </p>
        {/* The whole row clicks like the tools on the front page: the title's ::after
            stretches over it, and the row's ::before carries the hover fill out to the
            cell's edges. */}
        <ul>
          {
            posts.map((post) => (
              <li class="relative isolate border-t-hairline border-ink pb-[22px] pt-[18px] before:absolute before:-inset-x-4 before:inset-y-0 before:z-[-1] before:transition-colors before:duration-150 before:ease-out first:border-t-0 hover:before:bg-wash active:before:bg-wash has-[:focus-visible]:before:outline has-[:focus-visible]:before:outline-2 has-[:focus-visible]:before:outline-offset-[-2px] has-[:focus-visible]:before:outline-ink">
                <h3 class="text-balance text-title font-[640] leading-[1.3] tracking-[-0.01em]">
                  <a
                    href={post.href}
                    class="after:absolute after:inset-0 after:z-[1] focus-visible:outline-0"
                  >
                    {post.title}
                  </a>
                </h3>
                <p class="mt-1 font-dm-mono text-meta tabular-nums text-ink-3">
                  <time datetime={post.date.toISOString()} class="whitespace-nowrap">
                    {formatBlogDate(post.date)}
                  </time>
                  {post.minutesRead && <span class="whitespace-nowrap"> · {post.minutesRead}</span>}
                </p>
                <p class="mt-3 max-w-[66ch] text-pretty text-ink-2">{post.description}</p>
                {post.tags.length > 0 && (
                  <ul aria-label="Tags" class="mt-4 flex flex-wrap gap-1.5">
                    {post.tags.map((tag) => (
                      <li class="whitespace-nowrap border-hairline border-ink px-1.5 pb-0.5 pt-[3px] font-dm-mono text-label leading-[1.2] text-ink-2">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </Section>
    </Sections>
  </Frame>
</BaseLayout>
